set(AT32_DEVICE AT32F405CCT7 CACHE STRING "AT32F405CCT7 or AT32F405CBT7")
set_property(CACHE AT32_DEVICE PROPERTY STRINGS AT32F405CCT7 AT32F405CBT7)
if(AT32_DEVICE STREQUAL "AT32F405CCT7")
  set(APP_FLASH_KB 224)
  set(RAM_KB 96)
elseif(AT32_DEVICE STREQUAL "AT32F405CBT7")
  set(APP_FLASH_KB 96)
  set(RAM_KB 64)
else()
  message(FATAL_ERROR "Unsupported AT32_DEVICE=${AT32_DEVICE}")
endif()
set(JLINK_DEVICE ${AT32_DEVICE})
